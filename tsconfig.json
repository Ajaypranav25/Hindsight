{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "e2e", "scripts", "editors/vscode/src", "desktop/src", "*.ts"],
  "//": "editors/vscode/src/glue imports the vscode module, and the desktop app's glue, main and preload import electron; their types live only in each package's node_modules, so editors/vscode/tsconfig.json and desktop/tsconfig.json check them.",
  "exclude": [
    "editors/vscode/src/glue",
    "desktop/src/glue",
    "desktop/src/main.ts",
    "desktop/src/preload.ts"
  ]
}

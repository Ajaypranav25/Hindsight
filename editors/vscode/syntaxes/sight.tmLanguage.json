{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hindsight",
  "scopeName": "source.sight",
  "fileTypes": ["sight"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#function-signature" },
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#lambda" },
        { "include": "#builtins" },
        { "include": "#calls" },
        { "include": "#operators" },
        { "include": "#braces" },
        { "include": "#identifiers" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sight",
          "match": "//.*$"
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.sight",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.sight" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.sight" } },
      "patterns": [{ "include": "#block-comment" }]
    },
    "strings": {
      "name": "string.quoted.double.sight",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.sight" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.sight" } },
      "patterns": [
        {
          "name": "constant.character.escape.sight",
          "match": "\\\\(?:[ntr0\\\\\"{}]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.sight",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.sight",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.sight" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.sight" } },
      "contentName": "meta.embedded.line.sight",
      "patterns": [{ "include": "#expression" }]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.sight" } },
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.sight" } },
      "patterns": [{ "include": "#code" }]
    },
    "numbers": {
      "name": "constant.numeric.sight",
      "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sight",
          "match": "\\b(?:if|else|for|in|while|match|return|break|continue)\\b"
        },
        {
          "name": "storage.type.sight",
          "match": "\\b(?:fn|let|var)\\b"
        },
        {
          "name": "keyword.operator.word.sight",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "constant.language.sight",
          "match": "\\b(?:true|false|nil)\\b"
        }
      ]
    },
    "function-signature": {
      "comment": "fn name(params) [requires COND] [ensures COND] { ... }: requires/ensures are keywords only between the parameter list and the body.",
      "begin": "\\b(fn)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*(?=\\()",
      "beginCaptures": {
        "1": { "name": "storage.type.function.sight" },
        "2": { "name": "entity.name.function.sight" }
      },
      "end": "(?=\\{)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#parameters" },
        {
          "name": "keyword.other.contract.sight",
          "match": "\\b(?:requires|ensures)\\b"
        },
        { "include": "#expression" }
      ]
    },
    "parameters": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.sight" } },
      "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.sight" } },
      "patterns": [
        { "include": "#comments" },
        { "name": "keyword.operator.rest.sight", "match": "\\.\\.\\." },
        { "name": "variable.parameter.sight", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
        { "name": "punctuation.separator.parameter.sight", "match": "," }
      ]
    },
    "lambda": {
      "comment": "|a, b| body: the parameter list between bars, at the start of an expression.",
      "match": "(?<![\\w)\\]}])\\s*(\\|)(?!>)([^|\\n]*)(\\|)(?!>)",
      "captures": {
        "1": { "name": "punctuation.definition.parameters.begin.sight" },
        "2": {
          "patterns": [
            { "name": "keyword.operator.rest.sight", "match": "\\.\\.\\." },
            { "name": "variable.parameter.sight", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
            { "include": "#expression" }
          ]
        },
        "3": { "name": "punctuation.definition.parameters.end.sight" }
      }
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sight",
          "match": "\\b(?:print|str|repr|type|len|num|list|range|assert|panic|push|pop|insert|remove|slice|reverse|sort|contains|index_of|join|min|max|copy|keys|values|entries|has|get|delete|upper|lower|trim|split|replace|starts_with|ends_with|repeat|chars|char_code|from_char_code|pad_start|pad_end|abs|floor|ceil|sqrt|sin|cos|log|round|atan2|random|random_int|seed|steps|map|filter|reduce|each|find|find_index|any|all|count|sum|sort_by|zip|enumerate|flat_map|flatten|take|drop|uniq|group_by|min_by|max_by|times|chunk)\\b(?!\\s*:)"
        },
        {
          "name": "support.constant.sight",
          "match": "\\b(?:PI|INF)\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.sight" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.pipe.sight", "match": "\\|>" },
        { "name": "keyword.operator.range.sight", "match": "\\.\\.=|\\.\\.\\.|\\.\\." },
        { "name": "keyword.operator.arrow.sight", "match": "=>" },
        { "name": "keyword.operator.comparison.sight", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.compound.sight", "match": "\\+=|-=|\\*=|/=|%=" },
        { "name": "keyword.operator.assignment.sight", "match": "=" },
        { "name": "keyword.operator.arithmetic.sight", "match": "\\*\\*|[-+*/%]" },
        { "name": "punctuation.accessor.sight", "match": "\\." },
        { "name": "punctuation.separator.sight", "match": "[,:;]" }
      ]
    },
    "identifiers": {
      "name": "variable.other.sight",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}

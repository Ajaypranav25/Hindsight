// Every pattern form in let (SPEC §6.1).
let [a, b] = [1, 2]
let [first, ...rest] = [1, 2, 3]
let [...init, last] = [1, 2, 3]
let [p, ...mid, q] = [1, 2, 3, 4]
let [x, ...] = [9, 8]
let [y, ..._] = [7]
let [only, ...none] = [1]
print(a, b, first, rest, init, last) // expect: 1 2 1 [2, 3] [1, 2] 3
print(p, mid, q, x, y, only, none) // expect: 1 [2, 3] 4 9 7 1 []
let {name, age: years} = {name: "ann", age: 30, extra: true}
let {"full name": full} = {"full name": "A B"}
let [[n1, n2], {k}] = [[1, 2], {k: 3}]
print(name, years, full, n1, n2, k) // expect: ann 30 A B 1 2 3
let _ = 99
let 5 = 5
let "s" = "s"
let nil = nil
let 1..3 = 2
let [_, -1.5, true] = [0, -1.5, true]
print("all matched") // expect: all matched

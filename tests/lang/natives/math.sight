print(abs(-3), abs(2.5), floor(2.7), floor(-2.5), ceil(2.1), ceil(-2.9)) // expect: 3 2.5 2 -3 3 -2
print(sqrt(16), sqrt(2), sqrt(-1)) // expect: 4 1.4142135623730951 NaN
print(abs(sin(0)) < 1e-12, abs(cos(0) - 1) < 1e-12, abs(log(1)) < 1e-12, log(0), abs(atan2(0, 1)) < 1e-12) // expect: true true true -Infinity true
print(abs(sin(PI / 2) - 1) < 1e-12, abs(log(8) / log(2) - 3) < 1e-12) // expect: true true
print(round(2.5), round(-2.5), round(1.4), round(-1.6), round(0.49999999999999994)) // expect: 3 -3 1 -2 0
print(round(-0.4), round(7)) // expect: 0 7

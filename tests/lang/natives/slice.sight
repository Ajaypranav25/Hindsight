print(slice([1, 2, 3, 4], 1, 3)) // expect: [2, 3]
print(slice("hello", 1), slice("hello", 1, -1)) // expect: ello ell
print(slice([1, 2, 3], -2), slice([1, 2], 0, 10)) // expect: [2, 3] [1, 2]
print(slice([1, 2, 3], 0.9, 2.9)) // expect: [1, 2]
print(repr(slice("abc", 2, 1)), slice([1], 5)) // expect: "" []
let xs = [1, 2]
let ys = slice(xs, 0)
push(ys, 3)
print(xs, ys) // expect: [1, 2] [1, 2, 3]

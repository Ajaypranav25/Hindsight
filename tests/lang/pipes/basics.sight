// Pipes (SPEC §7.11).
fn double(x) { x * 2 }
fn sub(a, b) { a - b }
print(3 |> double) // expect: 6
print(3 |> double |> double) // expect: 12
print(10 |> sub(3)) // expect: 7
print([3, 1, 2] |> sort |> reverse) // expect: [3, 2, 1]
print([1, 2, 3] |> map(|x| x * x) |> sum) // expect: 14
print(5 |> |x| x * 2) // expect: 10
print("a,b" |> split(",") |> len) // expect: 2

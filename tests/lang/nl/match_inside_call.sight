// A block or match nested inside brackets is newline-sensitive again (SPEC §3.2).
let xs = [1, 2]
print(match xs {   // valid: arms are newline-separated even inside print( … )
  [] => "empty"
  [x] => "one"
  _ => "many"
}) // expect: many
let ys = [if true {
  let a = 1
  -2
  a
} else { 0 }]
print(ys) // expect: [1]
print(map([3], |x| {
  let y = x
  -1
  y
})) // expect: [3]

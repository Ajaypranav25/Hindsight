// Every loop iteration has fresh bindings (SPEC §5.6).
var fs = []
for i in 0..3 {
  push(fs, || i)
}
print(map(fs, |f| f())) // expect: [0, 1, 2]
var gs = []
for [a, b] in [[1, 2], [3, 4]] {
  push(gs, || a + b)
}
print(map(gs, |g| g())) // expect: [3, 7]
var hs = []
var m = 0
while m < 3 {
  let k = m
  push(hs, || k)
  m += 1
}
print(map(hs, |h| h())) // expect: [0, 1, 2]
var shared = []
var j = 0
while j < 3 {
  push(shared, || j)
  j += 1
}
print(map(shared, |s| s())) // expect: [3, 3, 3]

// Longest-match punctuators (SPEC §2.7).
print(2 ** 3 * 2) // expect: 16
print(1..=3) // expect: 1..=3
var x = 10
x -= 3
print(x) // expect: 7
x *= 2
print(x) // expect: 14
x /= 4
print(x) // expect: 3.5
x %= 2
print(x) // expect: 1.5
x += 1
print(x) // expect: 2.5
print(1 <= 1, 1 >= 2, 1 != 2, 2 == 2) // expect: true false true true
print([1, 2] |> len) // expect: 2

// Element k is exactly start + k * step (SPEC §7.6).
print(list(range(0, 1, 0.1)))
// expect: [0, 0.1, 0.2, 0.30000000000000004, 0.4, 0.5, 0.6000000000000001, 0.7000000000000001, 0.8, 0.9]
print(len(range(0, 1, 0.1))) // expect: 10
print(list(range(0, 0.9, 0.3)), len(range(0, 0.9, 0.3))) // expect: [0, 0.3, 0.6, 0.8999999999999999] 4
print(list(range(0.1, 0.4, 0.1)), len(range(0.1, 0.4, 0.1))) // expect: [0.1, 0.2, 0.30000000000000004] 3
print(list(range(1, 0, -0.25))) // expect: [1, 0.75, 0.5, 0.25]
var seen = []
for x in range(0, 1, 0.25) { push(seen, x) }
print(seen) // expect: [0, 0.25, 0.5, 0.75]

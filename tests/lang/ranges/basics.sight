// Ranges (SPEC §7.6).
print(0..5, 1..=3) // expect: 0..5 1..=3
print(list(0..5)) // expect: [0, 1, 2, 3, 4]
print(list(1..=3)) // expect: [1, 2, 3]
print(list(5..2), list(5..=5)) // expect: [] [5]
print(len(0..10), len(0..=10), len(5..2)) // expect: 10 11 0
print(range(4), range(2, 5)) // expect: 0..4 2..5
print(range(0, 10, 3)) // expect: range(0, 10, 3)
print(range(0, 1, 1)) // expect: 0..1
print(list(range(0, 10, 3))) // expect: [0, 3, 6, 9]
print(list(range(5, 0, -2)), len(range(5, 0, -2))) // expect: [5, 3, 1] 3
print(list(range(10, 0, -3))) // expect: [10, 7, 4, 1]
print(list(range(0, 5, -1))) // expect: []
print(-3..=-1, list(-3..=-1)) // expect: -3..=-1 [-3, -2, -1]
print(0.5..1.5, list(0.5..=2)) // expect: 0.5..1.5 [0.5, 1.5]
print([0..2, range(0, 6, 2)]) // expect: [0..2, range(0, 6, 2)]
print(type(0..1)) // expect: range

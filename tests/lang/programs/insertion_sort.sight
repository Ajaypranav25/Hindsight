fn insertion_sort(input) {
  var xs = copy(input)
  for i in 1..len(xs) {
    let key = xs[i]
    var j = i - 1
    while j >= 0 and xs[j] > key {
      xs[j + 1] = xs[j]
      j -= 1
    }
    xs[j + 1] = key
  }
  xs
}
let data = [5, 2, 9, 1, 5, 6]
print(insertion_sort(data)) // expect: [1, 2, 5, 5, 6, 9]
print(data) // expect: [5, 2, 9, 1, 5, 6]
print(insertion_sort([]), insertion_sort(["b", "a"])) // expect: [] ["a", "b"]

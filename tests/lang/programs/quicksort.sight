fn quicksort(xs) {
  match xs {
    [] => []
    [pivot, ...rest] => {
      let smaller = filter(rest, |x| x < pivot)
      let larger = filter(rest, |x| x >= pivot)
      [...quicksort(smaller), pivot, ...quicksort(larger)]
    }
  }
}
print(quicksort([3, 6, 1, 8, 2, 9, 2])) // expect: [1, 2, 2, 3, 6, 8, 9]
print(quicksort([])) // expect: []
print(quicksort(["pear", "apple", "fig"])) // expect: ["apple", "fig", "pear"]

fn shift_char(c, k) {
  let code = char_code(c)
  if code >= 97 and code <= 122 {
    from_char_code((code - 97 + k) % 26 + 97)
  } else if code >= 65 and code <= 90 {
    from_char_code((code - 65 + k) % 26 + 65)
  } else {
    c
  }
}
fn caesar(s, k) { join(map(chars(s), |c| shift_char(c, k))) }
let secret = caesar("Hello, World!", 3)
print(secret) // expect: Khoor, Zruog!
print(caesar(secret, -3)) // expect: Hello, World!
print(caesar("xyz", 29)) // expect: abc

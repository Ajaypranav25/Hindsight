// Equality (SPEC §7.4).
print(0 == -0, 1 == 1.0) // expect: true true
print("1" == 1, nil == false, nil == nil) // expect: false false true
print([1, 2] == [1, 2], [1, [2]] != [1, [3]]) // expect: true true
print({a: 1, b: 2} == {b: 2, a: 1}) // expect: true
print({a: 1} == {a: 1, b: 2}) // expect: false
print([] == {}, [] == []) // expect: false true
print(1..3 == 1..3, 1..3 == 1..=3, 1..3 == range(1, 3)) // expect: true false true
print(range(0, 10, 2) == range(0, 10, 2), range(0, 10, 2) == range(0, 10, 3)) // expect: true false
print(print == print, map == map, print == str) // expect: true true false
let f = |x| x
let g = |x| x
print(f == f, f == g) // expect: true false
let nan = INF - INF
print(nan == nan, nan != nan) // expect: false true
print([nan] == [nan]) // expect: false
let xs = [nan]
print(xs == xs) // expect: true

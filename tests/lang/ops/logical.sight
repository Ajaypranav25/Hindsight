// and / or / not (SPEC §7.5).
print(nil and 1, false and 1, 0 and 1) // expect: nil false 1
print(1 or 2, nil or "d", false or nil) // expect: 1 d nil
print(not 0, not "", not [], not nil, not false) // expect: false false false true true
var calls = 0
fn bump() { calls += 1; true }
false and bump()
true or bump()
print(calls) // expect: 0
true and bump()
nil or bump()
print(calls) // expect: 2

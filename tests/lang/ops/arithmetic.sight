// Arithmetic (SPEC §7.2).
print(1 + 2) // expect: 3
print(7 - 10) // expect: -3
print(6 * 7) // expect: 42
print(7 / 2) // expect: 3.5
print(1 / 3) // expect: 0.3333333333333333
print(100 / 3) // expect: 33.333333333333336
print(2 ** 10) // expect: 1024
print(2 ** 0, 0 ** 0, 4 ** 0.5) // expect: 1 1 2
print(2 ** 2000) // expect: Infinity
print(1e308 * 10, -1e308 * 10) // expect: Infinity -Infinity
print(INF - INF) // expect: NaN
print(2 ** 53 + 1) // expect: 9007199254740992
print(-(3)) // expect: -3
print(- -3) // expect: 3

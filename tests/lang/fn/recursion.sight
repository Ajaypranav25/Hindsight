fn fib(n) {
  if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}
for i in 0..10 {
  print("fib({i}) = {fib(i)}")
}
// expect: fib(0) = 0
// expect: fib(1) = 1
// expect: fib(2) = 1
// expect: fib(3) = 2
// expect: fib(4) = 3
// expect: fib(5) = 5
// expect: fib(6) = 8
// expect: fib(7) = 13
// expect: fib(8) = 21
// expect: fib(9) = 34
fn is_even(n) { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n) { if n == 0 { false } else { is_even(n - 1) } }
print(is_even(10), is_odd(7), is_even(3)) // expect: true true false
